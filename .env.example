# Copy to .env.local and fill in from Firebase console > Project settings > Your apps > Web app config.
# None of these are secrets: Firebase web config is public by design. Security comes from firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=
# The single shared login account you create in Firebase Authentication. Its password is the passcode.
VITE_LOGIN_EMAIL=scorecard@example.com
