# Used by `npm run dev:emulators` (vite --mode emulators). Local Firebase emulators only.
VITE_USE_EMULATORS=1
VITE_FIREBASE_API_KEY=fake-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-scorecard.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-scorecard
VITE_FIREBASE_APP_ID=demo-app
VITE_LOGIN_EMAIL=scorecard@example.com
