{
  "name": "scorecard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "demo": "vite --mode demo",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev:emulators": "vite --mode emulators",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-scorecard",
    "deploy": "npm test && npm run build && firebase deploy --only hosting,firestore"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "firebase": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "firebase-tools": "^15.35.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
